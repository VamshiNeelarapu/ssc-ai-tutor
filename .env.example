NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ssc_study
SESSION_SECRET=replace_me_with_32_char_min_secret_key
AI_PROVIDER=openrouter
AI_API_KEY=replace_me
AI_MODEL=anthropic/claude-3-haiku
NEXT_PUBLIC_APP_URL=http://localhost:3000



# Password recovery sends every account's OTP to this one configured email address.
# The sender address must be verified with Resend.
PASSWORD_RESET_EMAIL=
PASSWORD_RESET_FROM_EMAIL=
RESEND_API_KEY=
